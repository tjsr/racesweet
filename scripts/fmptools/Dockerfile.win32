FROM debian:bookworm-slim AS builder

ARG FMPTOOLS_VERSION=v0.2.2
ARG YAJL_VERSION=2.1.0
ARG LLVM_MINGW_VERSION=20260616
ARG BUILDARCH
ARG WINDOWS_TARGET_TRIPLE

RUN apt-get update && apt-get install --yes --no-install-recommends \
    autoconf \
    automake \
    build-essential \
    ca-certificates \
    cmake \
    gettext \
    git \
    libtool \
    make \
    pkg-config \
    wget \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /build

RUN test -n "${WINDOWS_TARGET_TRIPLE}" \
  && case "${BUILDARCH}" in amd64) toolchain_arch=x86_64 ;; arm64) toolchain_arch=aarch64 ;; *) exit 1 ;; esac \
  && wget --quiet "https://github.com/mstorsjo/llvm-mingw/releases/download/${LLVM_MINGW_VERSION}/llvm-mingw-${LLVM_MINGW_VERSION}-ucrt-ubuntu-22.04-${toolchain_arch}.tar.xz" \
  && tar --extract --xz --file "llvm-mingw-${LLVM_MINGW_VERSION}-ucrt-ubuntu-22.04-${toolchain_arch}.tar.xz" \
  && mv "llvm-mingw-${LLVM_MINGW_VERSION}-ucrt-ubuntu-22.04-${toolchain_arch}" /opt/llvm-mingw

ENV PATH=/opt/llvm-mingw/bin:$PATH

RUN git clone --depth 1 --branch ${YAJL_VERSION} https://github.com/lloyd/yajl.git \
  && sed --in-place '/\/W4/d; /\/wd4996/d; /\/O2/d' yajl/CMakeLists.txt yajl/src/CMakeLists.txt \
  && cmake -S yajl -B yajl-build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_C_COMPILER=${WINDOWS_TARGET_TRIPLE}-clang \
    -DCMAKE_INSTALL_PREFIX=/opt/windows-target \
    -DCMAKE_SYSTEM_NAME=Windows \
    -DBUILD_SHARED_LIBS=OFF \
  && cmake --build yajl-build --target yajl_s --parallel \
  && mkdir --parents /opt/windows-target/include /opt/windows-target/lib \
  && cp --recursive yajl-build/yajl-2.1.0/include/yajl /opt/windows-target/include/ \
  && cp yajl-build/yajl-2.1.0/lib/libyajl_s.a /opt/windows-target/lib/libyajl.a

RUN wget --quiet https://ftp.gnu.org/pub/gnu/libiconv/libiconv-1.18.tar.gz \
  && tar --extract --gzip --file libiconv-1.18.tar.gz \
  && cd libiconv-1.18 \
  && CC=${WINDOWS_TARGET_TRIPLE}-clang \
    ./configure --host=${WINDOWS_TARGET_TRIPLE} --prefix=/opt/windows-target --disable-shared --enable-static \
  && make \
  && make install

RUN git clone --depth 1 --branch ${FMPTOOLS_VERSION} https://github.com/evanmiller/fmptools.git \
  && cd fmptools \
  && sed --in-place 's@fopen(path, "r")@fopen(path, "rb")@' src/fmp.c \
  && sed --in-place 's@<sys/errno.h>@<errno.h>@' src/scsu.c \
  && autoreconf --install --force \
  && PKG_CONFIG_LIBDIR=/opt/windows-target/lib/pkgconfig \
    PKG_CONFIG_PATH=/opt/windows-target/lib/pkgconfig \
    CC=${WINDOWS_TARGET_TRIPLE}-clang \
    CPPFLAGS=-I/opt/windows-target/include \
    LIBS='-liconv -lcharset' \
    LDFLAGS='-L/opt/windows-target/lib -static' \
    ./configure --host=${WINDOWS_TARGET_TRIPLE} --prefix=/opt/windows-target \
  && make

FROM scratch AS artifact

COPY --from=builder /build/fmptools/fmp2json.exe /fmp2json.exe
